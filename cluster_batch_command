cat >/home/giese/alappe95/projects/monkeymonkey/batch_files/train.sbatch
<<'SH'
#!/usr/bin/env bash
#SBATCH -J train
#SBATCH -p a100-galvani
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH -t 70:00:00
#SBATCH --chdir=/home/giese/alappe95/projects/monkeymonkey
#SBATCH
--output=/home/giese/alappe95/projects/monkeymonkey/logs/train-%j.out
#SBATCH --error=/home/giese/alappe95/projects/monkeymonkey/logs/train-%j.err
#SBATCH --signal=USR1@180

set -euxo pipefail
umask 007
echo "=== START $(date) ==="
pwd

# --------- CONFIGURABLE ---------
: "${PROJECT_ROOT:=/home/giese/alappe95/projects/monkeymonkey}"
# Or use Lustre consistently:
# : "${PROJECT_ROOT:=/mnt/lustre/home/giese/alappe95/projects/monkeymonkey}"

# Either set CONFIG, or comment out RUN_DIR logic that needs it:
: "${CONFIG:=configs/cluster.json}"

# Choose ONE of these two (prefer they match PROJECT_ROOT):
: "${ENTRY_FILE:=${PROJECT_ROOT}/train/training.py}"
: "${MODULE_NAME:=}"   # e.g., modeling.dinov3.upsampling.finetune


# Derived dirs
RUN_DIR="$PROJECT_ROOT/runs/${SLURM_JOB_NAME:-job}-${SLURM_JOB_ID:-noid}"
mkdir -p "$PROJECT_ROOT/logs" "$RUN_DIR" "$RUN_DIR/checkpoints"

# ---- pick python from your env (no conda activate needed) ----
PYTHON=""
for p in \
"/mnt/lustre/work/giese/alappe95/conda/envs/monkeymonkey/bin/python" \
   "/home/giese/alappe95/miniconda3/envs/monkeymonkey/bin/python" \
   "/home/giese/alappe95/anaconda3/envs/monkeymonkey/bin/python" \
   "/home/giese/alappe95/.miniconda3/envs/monkeymonkey/bin/python" \
   "/home/giese/alappe95/.anaconda3/envs/monkeymonkey/bin/python" \
   "/home/giese/alappe95/.conda/envs/monkeymonkey/bin/python"
do
   if [ -x "$p" ]; then PYTHON="$p"; break; fi
done
[ -n "$PYTHON" ] || { echo "FATAL: can't find python in env
'monkeymonkey'"; exit 90; }
echo "Using python: $PYTHON"; "$PYTHON" -V || true

# ---- sanity ----
[ -r "$CONFIG" ] || { echo "FATAL: Config not found: $CONFIG"; exit 2; }
[ -r "$ENTRY_FILE" ] || { echo "FATAL: ENTRY_FILE not found:
$ENTRY_FILE"; exit 3; }

export PYTHONUNBUFFERED=1
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export NCCL_DEBUG=WARN
export
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,max_split_size_mb:128"
nvidia-smi || true

# ---- graceful preemption / time warning ----
trap 'echo "[USR1] $(date): preemption/time-warning received; consider
checkpointing here..." >&2' USR1

# ---- build args ----
ARGS=(
   --config-path "$CONFIG"
   --batch-size 16
   --img-size 448
   --n-epochs 100
   --lr 0.001
)

echo "Final ARGS: ${ARGS[*]}"

# ---- launch ----
NGPUS="${SLURM_GPUS_PER_NODE:-${SLURM_GPUS_ON_NODE:-${SLURM_GPUS:-1}}}"
echo "GPUs on node: $NGPUS"

if [ -n "$MODULE_NAME" ]; then
   if [ "$NGPUS" -gt 1 ]; then
     srun "$PYTHON" -u -m torch.distributed.run --standalone
--nproc_per_node="$NGPUS" -m "$MODULE_NAME" "${ARGS[@]}"
   else
     srun "$PYTHON" -u -m "$MODULE_NAME" "${ARGS[@]}"
   fi
else
   if [ "$NGPUS" -gt 1 ]; then
     srun "$PYTHON" -u -m torch.distributed.run --standalone
--nproc_per_node="$NGPUS" "$ENTRY_FILE" "${ARGS[@]}"
   else
     srun "$PYTHON" -u "$ENTRY_FILE" "${ARGS[@]}"
   fi
fi

rc=$?
echo "=== END $(date) rc=$rc ==="
exit "$rc"
SH
